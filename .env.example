# Application Configuration
PROJECT_NAME="Document Question Extraction Service"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Security & Authentication
SECRET_KEY="change_this_to_a_secure_random_32_byte_hex_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL)
# For local Docker: postgresql://postgres:postgres@localhost:5432/doc_extractor_db
# In Docker compose: postgresql://postgres:postgres@postgres:5432/doc_extractor_db
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/doc_extractor_db"

# Redis & Celery Message Broker
# In Docker compose: redis://redis:6379/0
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# File Storage Configuration
STORAGE_BACKEND="local"
UPLOAD_DIR="./data/uploads"
PAGE_IMAGE_DIR="./data/page_images"
MAX_UPLOAD_SIZE_BYTES=20971520

# OCR Configuration (Leave empty to use system tesseract)
TESSERACT_CMD=""

# Pluggable AI Configuration (Default: mock for zero cost/deterministic testing)
AI_PROVIDER="mock"
AI_API_KEY=""
AI_MODEL_NAME="mock-model"
